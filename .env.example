# ─────────────────────────────────────────────
# Database (Supabase-Vercel integration)
# These are injected automatically by the Supabase-Vercel integration.
# POSTGRES_PRISMA_URL: pooler URL with pgbouncer=true (for runtime queries)
# POSTGRES_URL_NON_POOLING: direct URL (for db:push / db:migrate)
# ─────────────────────────────────────────────
POSTGRES_PRISMA_URL="postgres://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────
# NextAuth
# Generate a secret: openssl rand -base64 32
# ─────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# Single-User Credentials
# ADMIN_PASSWORD_HASH is the bootstrap hash used on first login.
# After setting up the app, change your password via Settings → Account.
# To generate an initial hash:
#   node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(h=>console.log(h))"
# ─────────────────────────────────────────────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="$2a$12$..."

# ─────────────────────────────────────────────
# App Identity (used for DB userId — keep stable)
# ─────────────────────────────────────────────
APP_USER_ID="default-user"

# ─────────────────────────────────────────────
# Local SQLite dev (no Supabase credentials needed)
# Add DATABASE_URL below to .env.local to activate SQLite mode.
# Then run once:
#   npm run db:dev:generate   ← generate SQLite Prisma client
#   npm run dev               ← auto-creates dev.db and starts the app
#   npm run db:dev:seed       ← (optional) seed default categories
# POSTGRES_* vars are ignored when DATABASE_URL is set.
# ─────────────────────────────────────────────
# DATABASE_URL="file:./dev.db"
