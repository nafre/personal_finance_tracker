# ─────────────────────────────────────────────
# Read-only connection to the Supabase Postgres DB.
# Create a read-only role first (see README), then use its pooled URL here.
# Falls back to POSTGRES_PRISMA_URL if DATABASE_READONLY_URL is unset.
# ─────────────────────────────────────────────
DATABASE_READONLY_URL="postgres://claude_ro:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# The user whose data this server exposes. Matches APP_USER_ID in the main app.
EXPENSE_USER_ID="default-user"

# ─────────────────────────────────────────────
# HTTP transport only (Phase 2 / Render). Leave unset for local stdio.
# A shared bearer token guards the /mcp endpoint. For Claude.ai web/mobile
# custom connectors you will need full OAuth instead — see README.
# ─────────────────────────────────────────────
# PORT="3333"
# MCP_BEARER_TOKEN="<long-random-secret>"
